# Copy to .env and fill in. Never commit .env.
EM_DATA_GO_KR_KEY=
EM_DATA_GO_KR_KEY_PHARMACY=
EM_PROVIDER=mock
# 1 = enable /demo/chaos failure injection (demo only). Leave empty in normal use.
EM_DEMO_CHAOS=
# anthropic = LLM rewrites the advice and fills a missing place/time (rules keep severity and 119).
# Empty or off = rules and templates only. See docs/llm.md.
EM_LLM=
EM_LLM_MODEL=
ANTHROPIC_API_KEY=
